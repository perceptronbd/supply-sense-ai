{
  "displayName": "Module Verification Tests",
  "testMatch": ["**/*-verification.spec.ts"],
  "testEnvironment": "node",
  "transform": {
    "^.+\\.(t|j)sx?$": [
      "ts-jest",
      {
        "tsconfig": "backend-e2e/tsconfig.spec.json"
      }
    ]
  },
  "moduleFileExtensions": ["ts", "tsx", "js", "jsx"],
  "coverageDirectory": "../../../coverage/backend-e2e",
  "collectCoverageFrom": ["**/*.(t|j)s"],
  "testTimeout": 10000
}
