{
  "name": "@supplysense/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "mcp-server:serve": "npx nx serve mastra-mcp-server",
    "mcp-server:build": "npx nx build mastra-mcp-server",
    "mcp-server:start": "node dist/mastra-mcp-server/main.mjs",
    "backend:serve": "npx nx serve backend",
    "backend:build": "npx nx build backend",
    "backend:start": "node dist/backend/main.js",
    "backend:test": "npx nx test backend",
    "frontend:serve": "npx nx dev frontend",
    "frontend:build": "npx nx build frontend && npm run frontend:clean-cache",
    "frontend:start": "npx nx serve frontend",
    "frontend:test": "npx nx test frontend",
    "frontend:analyze": "ANALYZE=true npx nx build frontend",
    "frontend:clean": "npx nx reset frontend",
    "frontend:clean-cache": "node -e \"const fs = require('fs'); const path = require('path'); const cacheDir = path.join('dist/frontend/.next/cache'); if (fs.existsSync(cacheDir)) { fs.rmSync(cacheDir, { recursive: true, force: true }); console.log('✅ Webpack cache cleaned from build output'); } else { console.log('ℹ️ No cache directory found to clean'); }\"",
    "build:all": "npx nx run-many -t build --projects=backend,frontend,mastra-mcp-server --parallel=3",
    "start": "pnpm run start:prod",
    "start:prod": "concurrently \"pnpm run backend:start\" \"pnpm run frontend:start\" \"pnpm run mcp-server:start\"",
    "db:deploy": "cd backend && npx prisma migrate deploy",
    "db:dev": "cd backend && npx prisma migrate dev",
    "db:start": "docker-compose up -d postgres",
    "db:stop": "docker-compose stop postgres",
    "db:generate": "cd backend && npx prisma generate",
    "db:seed": "cd backend && npx tsx prisma/seed.ts",
    "start:dev": "pnpm run db:start && pnpm run backend:serve",
    "dev": "concurrently \"pnpm run db:start\" \"pnpm run backend:serve\" \"pnpm run frontend:serve\" \"pnpm run mcp-server:serve\"",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css}": ["biome check --write"]
  },
  "private": true,
  "devDependencies": {
