{
  "name": "@supplysense/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "mastra:serve": "npx nx serve mastra-mcp",
    "mastra:build": "cd mastra-mcp && mastra build",
    "backend:serve": "npx nx serve backend",
    "backend:build": "npx nx build backend",
    "backend:start": "node dist/backend/main.js",
    "backend:test": "npx nx test backend",
    "frontend:serve": "npx nx dev frontend",
    "frontend:build": "npx nx build frontend && npm run frontend:clean-cache",
    "frontend:start": "pnpm exec nx serve frontend --configuration=production --port=3000 --hostname=0.0.0.0",
    "frontend:test": "npx nx test frontend",
    "frontend:analyze": "ANALYZE=true npx nx build frontend",
    "frontend:clean": "npx nx reset frontend",
    "frontend:clean-cache": "node -e \"const fs = require('fs'); const path = require('path'); const cacheDir = path.join('dist/frontend/.next/cache'); if (fs.existsSync(cacheDir)) { fs.rmSync(cacheDir, { recursive: true, force: true }); console.log('✅ Webpack cache cleaned from build output'); } else { console.log('ℹ️ No cache directory found to clean'); }\"",
    "landing:serve": "npx nx dev landing-page",
    "landing:build": "npx nx build landing-page",
    "landing:start": "pnpm exec nx serve landing-page --configuration=production --port=3002 --hostname=0.0.0.0",
    "landing:test": "npx nx test landing-page",
    "landing:analyze": "ANALYZE=true npx nx build landing-page",
    "landing:clean": "npx nx reset landing-page",
    "build:all": "npx nx run-many -t build --projects=backend,frontend,mastra-mcp-server --parallel=3",
    "start": "pnpm run start:prod",
    "start:prod": "concurrently \"pnpm run backend:start\" \"pnpm run frontend:start\" \"pnpm run mcp-server:start\"",
    "db:deploy": "cd backend && npx prisma migrate deploy --schema=../libs/shared/prisma/schema.prisma",
    "db:dev": "cd backend && npx prisma migrate dev --schema=../libs/shared/prisma/schema.prisma",
    "db:start": "docker-compose up -d postgres",
    "db:stop": "docker-compose stop postgres",
    "db:generate": "npx prisma generate --schema=libs/shared/prisma/schema.prisma",
    "db:studio": "npx prisma studio --schema=libs/shared/prisma/schema.prisma",
    "db:seed": "cd libs/shared/prisma && npx tsx src/lib/seeds/index.ts",
    "start:dev": "pnpm run db:start && pnpm run backend:serve",
    "dev": "concurrently \"pnpm run mastra:serve\" \"pnpm run backend:serve\" \"pnpm run frontend:serve\"",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css}": ["biome check --write"]
  },
  "private": true,
