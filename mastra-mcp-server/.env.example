OPENROUTER_API_KEY=api-key-here # Your OpenRouter API key for LLM access

# Server Configuration
NODE_ENV=development # Change to 'production' in a production environment
MCP_PORT=3002 # Port for the MCP server
MCP_HOST=localhost # Host for the MCP server


DATABASE_URL="postgresql://username:password@your-db-host:5432/supply_chain_ai" # e.g. postgresql://user:pass@host:5432/dbname
DB_ENCRYPTION_KEY="your-32-character-secret-key-here" # Use a secure random string, exactly 32 characters