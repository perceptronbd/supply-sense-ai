# Mastra MCP Server Environment Configuration

# LLM provider configuration
OPENROUTER_API_KEY=your-openrouter-api-key

# Server settings
NODE_ENV=development
PORT=3005
MCP_PORT=3005
MCP_HOST=0.0.0.0

# Database connection
DATABASE_URL="postgresql://user:password@host:5432/database"
DB_ENCRYPTION_KEY="replace-with-32-character-key"
