{
  "name": "mastra-mcp",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "mastra-mcp/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/.mastra"],
      "options": {
        "command": "mastra build --root mastra-mcp --dir src/mastra",
        "cwd": "mastra-mcp"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["mastra dev", "npx tsx -r dotenv/config src/main.ts"],
        "parallel": true,
        "cwd": "mastra-mcp"
      }
    }
  },
  "tags": []
}
