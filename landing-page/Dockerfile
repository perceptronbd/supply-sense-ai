# Multi-stage build for Next.js application optimized for Dokploy deployment
# Stage 1: Base image with common setup
FROM node:20-alpine AS base

# Install dependencies only when needed
FROM base AS deps
# libc6-compat is needed for some native dependencies on Alpine
RUN apk add --no-cache libc6-compat
WORKDIR /app

# Install pnpm globally
RUN npm install -g pnpm

# Copy package files from monorepo root
COPY package.json pnpm-lock.yaml* ./

# Copy Nx configuration files
COPY nx.json tsconfig.base.json ./

# Install all dependencies
RUN pnpm install --frozen-lockfile

# Stage 2: Build the application
FROM base AS builder
WORKDIR /app

# Copy node_modules from deps stage
COPY --from=deps /app/node_modules ./node_modules

# Copy package files from monorepo root (needed for pnpm commands)
COPY package.json pnpm-lock.yaml* ./

# Copy Nx configuration files
COPY nx.json tsconfig.base.json ./

# Copy shared libraries
COPY libs ./libs

# Copy only the landing-page source code
COPY landing-page ./landing-page

# Install pnpm in builder stage
RUN npm install -g pnpm

# Disable Next.js telemetry during build
ENV NEXT_TELEMETRY_DISABLED=1

# Enable standalone output for Docker builds
ENV DOCKER_BUILD=true

# Add build arguments for environment variables
ARG NEXT_PUBLIC_BACKEND_API_URL
ARG NEXT_PUBLIC_FRONTEND_URL
ENV NEXT_PUBLIC_BACKEND_API_URL=$NEXT_PUBLIC_BACKEND_API_URL
ENV NEXT_PUBLIC_FRONTEND_URL=$NEXT_PUBLIC_FRONTEND_URL

# Build the landing-page application using nx
RUN npx nx build landing-page --configuration production

# Stage 3: Prepare production dependencies only
FROM deps AS prod-deps
ENV NODE_ENV=production
RUN pnpm install --prod --frozen-lockfile --ignore-scripts

# Stage 4: Production runner - minimal image for Dokploy
FROM base AS runner
WORKDIR /app

# Install curl for health checks and tini for proper signal handling
RUN apk add --no-cache curl tini

# Set production environment
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Create non-root user for security (Dokploy best practice)
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Copy public assets
COPY --from=builder /app/landing-page/public ./public

# Copy built Next.js assets generated by Nx
COPY --from=builder --chown=nextjs:nodejs /app/dist/landing-page/.next ./.next
COPY --from=builder --chown=nextjs:nodejs /app/dist/landing-page/package.json ./package.json
COPY --from=builder --chown=nextjs:nodejs /app/dist/landing-page/next.config.js ./next.config.js

# Copy .nx-helpers if it exists (for Nx compatibility)
COPY --from=builder --chown=nextjs:nodejs /app/dist/landing-page/.nx-helpers* ./.nx-helpers/

# Include node_modules for the Next.js production server
COPY --from=prod-deps --chown=nextjs:nodejs /app/node_modules ./node_modules

# Ensure ownership of the working directory
RUN chown -R nextjs:nodejs /app

# Switch to non-root user
USER nextjs

# Expose port for Dokploy (configurable via PORT env)
EXPOSE 3002

# Environment variables for Dokploy compatibility
ENV PORT=3002
ENV HOSTNAME="0.0.0.0"

# Health check for Dokploy monitoring
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD curl -f http://localhost:${PORT:-3002}/api/health || curl -f http://localhost:${PORT:-3002}/ || exit 1

# Use tini as entrypoint for proper signal handling (important for container orchestration)
ENTRYPOINT ["/sbin/tini", "--"]

# Start the production server using the Next.js CLI
# Uses PORT env variable for Dokploy port configuration
CMD ["node", "node_modules/next/dist/bin/next", "start", "-H", "0.0.0.0", "-p", "3002"]
