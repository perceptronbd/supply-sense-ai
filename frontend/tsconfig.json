{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "es2022",
    "lib": ["dom", "dom.iterable", "es6"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@supplysense/types": ["../libs/shared/src/index.ts"],
      "@supplysense/utils": ["../libs/shared/utils/src/index.ts"],
      "@supplysense/constant": ["../libs/shared/constant/src/index.ts"]
    },
    "forceConsistentCasingInFileNames": true,
    "types": ["jest", "node"],
    "preserveWatchOutput": true,
    "tsBuildInfoFile": ".next/cache/tsconfig.tsbuildinfo"
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../../dist/frontend/.next/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    "../dist/frontend/.next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "cypress",
    "cypress.config.ts",
    "**/*.cy.ts",
    ".next",
    "dist"
  ]
}
