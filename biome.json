{
  "$schema": "https://biomejs.dev/schemas/2.3.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/coverage",
      "!**/.nx",
      "!**/tmp",
      "!**/.next",
      "!**/build",
      "!**/*.d.ts",
      "!**/migrations/**/*.sql",
      "!**/jest.config.ts",
      "!**/jest.preset.js",
      "!**/cypress.config.ts",
      "!**/webpack.config.js",
      "!**/next.config.js",
      "!**/postcss.config.js",
      "!**/.mastra"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "noExcessiveCognitiveComplexity": "warn",
        "noVoid": "off"
      },
      "correctness": {
        "noUnusedVariables": "warn",
        "useExhaustiveDependencies": "warn",
        "noUnusedImports": "error",
        "noUnusedPrivateClassMembers": "warn",
        "useJsxKeyInIterable": "off",
        "useValidTypeof": "error"
      },
      "style": {
        "noNonNullAssertion": "warn",
        "useImportType": "off",
        "useNodejsImportProtocol": "error"
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noArrayIndexKey": "warn",
        "noEmptyBlock": "warn",
        "noFallthroughSwitchClause": "error",
        "noImplicitAnyLet": "error",
        "noUnsafeDeclarationMerging": "error"
      },
      "a11y": {
        "noSvgWithoutTitle": "off"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    },
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "es5"
    }
  },
  "json": {
    "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 2
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.spec.ts", "**/*.e2e-spec.ts", "**/test-helpers.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          },
          "complexity": {
            "noStaticOnlyClass": "off",
            "noForEach": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/frontend/**/*.tsx",
        "**/frontend/**/*.css",
        "**/landing-page/**/*.tsx",
        "**/landing-page/**/*.css"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noEmptyBlock": "off",
            "noDuplicateFontNames": "off",
            "noUnknownAtRules": "off"
          },
          "a11y": {
            "noSvgWithoutTitle": "off"
          }
        }
      }
    },
    {
      "includes": ["**/backend/**/*.ts", "**/mastra-mcp/**/*.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "useHookAtTopLevel": "off"
          }
        }
      }
    },
    {
      "includes": ["**/prisma/**"],
      "linter": {
        "enabled": false
      },
      "formatter": {
        "enabled": false
      }
    }
  ]
}
