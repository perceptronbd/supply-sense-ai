{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../dist/out-tsc",
    "module": "commonjs",
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "es2021",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@app/*": ["./src/app/*"],
      "@modules/*": ["./src/modules/*"],
      "@common/*": ["./src/modules/common/*"],
      "@supplysense/types": ["../libs/shared/src/index.ts"],
      "@supplysense/constant": ["../libs/shared/constant/src/index.ts"],
      "@supplysense/utils": ["../libs/shared/utils/src/index.ts"],
      "@supplysense/utils/server": ["../libs/shared/utils/src/server.ts"],
      "@supplysense/prisma": ["../libs/shared/prisma/src/index.ts"],
      "@supplysense/prisma-client": ["../libs/shared/prisma/generated"],
      "@supplysense/mastra": ["../libs/shared/mastra/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "../libs/shared/prisma/src/lib/prisma.module.ts",
    "../libs/shared/prisma/src/lib/prisma.service.ts"
  ],
  "exclude": ["jest.config.ts", "src/**/*.spec.ts", "src/**/*.test.ts"]
}
