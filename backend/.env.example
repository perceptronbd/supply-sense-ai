DATABASE_URL="database-connection-string-here" # e.g. postgresql://user:pass@host:5432/dbname
PUBLIC_DB_CONNECTION_ID="public-db-connection-id-here"

NODE_ENV=development
PORT=3004
FRONTEND_URLS="http://localhost:3000,http://localhost:3001" # Comma-separated list of allowed frontend URLs for CORS. Each URL must include protocol (http/https) and host (optionally port). Examples: https://app.example.com, http://localhost:3000, https://staging.example.com:8080

OPENROUTER_API_KEY=openrouter-api-key-here # Optional, for OpenRouter integration
DB_ENCRYPTION_KEY="database-encryption-key-here" # Use a secure random string
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_ACCESS_TOKEN_EXPIRES_IN="15m"

# MCP Server settings
MASTRA_SERVER_URL=http://localhost:3002 # URL of the MCP server within the same network
MCP_SERVER_TIMEOUT=120000  # 2 minutes for complex table analysis operations

# Example 1: Default limits (same as before)
# type Array<{name:"",window:"",maxRequests:""}> 
RATE_LIMIT_CONFIG='[{"name":"minute","window":"1m","maxRequests":5},{"name":"hour","window":"1h","maxRequests":30},{"name":"day","window":"1d","maxRequests":200}]'
