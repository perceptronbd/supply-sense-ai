# Database connection string for PostgreSQL
DATABASE_URL="postgresql://admin:password@localhost:5432/supply_chain_ai?schema=public"

# Application settings
NODE_ENV=development
PORT=3000

# JWT settings (placeholder for future authentication)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# API settings
API_PREFIX=api
DB_ENCRYPTION_KEY="your-32-character-secret-key-here"

# Google Gemini AI settings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenRouter AI (required)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Frontend URLs
FRONTEND_URLS=http://localhost:3001

# MCP Server settings
MCP_SERVER_URL=http://localhost:3002
MCP_SERVER_TIMEOUT=30000


# Table Description Agent Timeout Configuration
# Default timeout for table description generation (in milliseconds)
TABLE_DESCRIPTION_TIMEOUT_MS=30000

# Maximum allowed timeout for table description generation (in milliseconds)
TABLE_DESCRIPTION_MAX_TIMEOUT_MS=120000
