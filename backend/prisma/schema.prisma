// SupplySense Management MVP - Database Schema
// Based on detailed MVP requirements for manufacturing supply chain management
// Core Modules: PR (Purchase Request), PO (Purchase Order), GR (Goods Receipt), 
// RF (Request Form), MR (Material Requisition), ML (Manufacturing List), Formula

generator client {
  provider = "prisma-client-js"
  // output   = "../../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// CORE SYSTEM MODELS - Multi-Tenant SaaS Architecture
// ============================================================================

// Company - Top-level tenant for complete data isolation
model Company {
  id              String  @id @default(uuid())
  name            String
  taxId           String? @unique // Business registration number
  businessAddress String?
  contactPhone    String?
  contactEmail    String  @unique
  isActive        Boolean @default(true)
  industry        String? // Added industry field

  // Company settings
  defaultCurrency String @default("USD")
  timezone        String @default("UTC")

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships - All company-owned entities
  users                        User[]
  roles                        Role[]
  DbConnection                 DbConnection[]
  companySubscription          CompanySubscription?
  companySubscriptionHistories CompanySubscriptionHistory[]
  UsageTracking                UsageTracking[]
  purchaseHistory              PurchaseHistory[]
  UsageRecord                  UsageRecord[]

  @@index([name], name: "idx_company_name")
  @@map("companies")
}

// Custom Role - Discord-like role system with granular permissions
model Role {
  id          String  @id @default(uuid())
  name        String // e.g., "Branch Manager", "Senior Inventory Clerk"
  description String?
  isActive    Boolean @default(true)

  // Company isolation
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  permissions RolePermission[]
  userRoles   UserRole[]

  @@unique([companyId, name])
  @@map("roles")
}

// Permission modules enum
enum PermissionModule {
  USERS
  COMPANIES
  BRANCHES
  ITEMS
  SUPPLIERS
  FORMULAS
  PURCHASE_REQUESTS
  PURCHASE_ORDERS
  MATERIAL_REQUISITIONS
  REQUEST_FORMS
  MANUFACTURING_LISTS
  GOODS_RECEIPTS
  ROLES
  PERMISSIONS
  AI
  CHAT
}

// Permission actions enum
enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
  APPROVE
  REJECT
  SUBMIT
  CANCEL
  EXPORT
  IMPORT
  MANAGE
  MANAGE_ROLES
  MANAGE_PERMISSIONS
  LOGIN
  LOGOUT
  REFRESH
  REGISTER
  ACCESS_SUGGESTIONS
  MANAGE_SUGGESTIONS
  DEMAND_FORECASTING
  ANALYTICS
  SEND_MESSAGE
  READ_MESSAGES
  MANAGE_CONVERSATIONS
}

// Permission - Module-level permissions
model Permission {
  id          String           @id @default(uuid())
  module      String
  action      PermissionAction
  description String?

  // Relationships
  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

// Role-Permission junction table
model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// User Management & Authentication - Multi-tenant with custom roles
model User {
  id           String  @id @default(uuid())
  email        String  @unique
  username     String  @unique
  firstName    String?
  lastName     String?
  phone        String?
  governmentId String? // Employee ID or government ID
  password     String
  avatar       String?
  isActive     Boolean @default(true)
  isSuperAdmin Boolean @default(false) // Company Super Admin flag

  // Company isolation
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  lastLogin DateTime?

  // Relationships - Multi-tenant with role-based access
  userRoles            UserRole[] // Multiple roles per user

  @@map("users")
}

// User-Role junction table for multiple role assignments
model UserRole {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  // Timestamps
  assignedAt DateTime @default(now())
  assignedBy String? // User ID of who assigned this role

  @@unique([userId, roleId])
  @@map("user_roles")
}



model SchemaCache {
  id             String       @id @default(uuid())
  schema         Json
  cachedAt       DateTime     @default(now())
  dbConnectionId String       @unique // One-to-one relationship with Company
  dbConnection   DbConnection @relation(fields: [dbConnectionId], references: [id], onDelete: Cascade)

  @@index([dbConnectionId], name: "idx_schema_cache_db_connection")
  @@map("schema_cache")
}

model DbConnection {
  id              String  @id @default(uuid())
  host            String
  port            Int
  database        String
  username        String
  title           String?
  businessContext String? @default("") // Added business context field

  encryptedPassword String // Store encrypted password
  sslEnabled        Boolean  @default(false)
  connectionHash    String   @unique // Hash of connection details for uniqueness
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  companyId      String
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  TableRelations TableRelations[]
  TableMetadata  TableMetadata[]
  SchemaCache    SchemaCache?

  @@unique([companyId, username], name: "unique_db_connection")
  @@index([companyId, id], name: "idx_db_connections_company_id")
  @@index([username], name: "idx_db_connections_username")
  @@map("db_connections")
}

model TableRelations {
  id          String  @id @default(uuid())
  tableName   String
  columnName  String
  refTable    String // Referenced table name
  refColumn   String // Referenced column name
  isConfirmed Boolean @default(false) // Whether this relation has been confirmed by the user

  dbConnectionId String
  dbConnection   DbConnection @relation(fields: [dbConnectionId], references: [id], onDelete: Cascade)

  @@unique([dbConnectionId, tableName, columnName], name: "unique_table_relation")
  @@index([tableName, columnName], name: "idx_table_relations_table_column")
  @@index([dbConnectionId, id], name: "idx_table_relations_db_connection")
  @@map("table_relations")
}

model TableMetadata {
  id              String   @id @default(uuid())
  tableName       String
  friendlyLabel   String
  purpose         String
  updateFrequency String
  dataSensitivity String
  sampleQuestions String[]

  dbConnectionId String // One-to-many relationship with DbConnection
  dbConnection   DbConnection @relation(fields: [dbConnectionId], references: [id], onDelete: Cascade)

  @@unique([dbConnectionId, tableName], name: "unique_table_metadata")
  @@index([dbConnectionId, id], name: "idx_table_metadata_db_connection")
  @@map("table_metadata")
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PAST_DUE
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionPlans {
  STARTER
  BUSINESS
  ENTERPRISE
}

model SubscriptionPlan {
  id                           String                       @id @default(uuid())
  name                         SubscriptionPlans            @default(STARTER) // STARTER, BUSINESS, ENTERPRISE
  priceMonthly                 Decimal                      @default(0) // Monthly subscription price
  credits                      Decimal
  priceYearly                  Decimal                      @default(0) // Yearly subscription price
  apiRequestsLimit             Int                          @default(0) // API request limit per month
  roleBasedAccess              Boolean                      @default(false) // Role-based permissions
  advancedFiltering            Boolean                      @default(false) // Tagging, categorization, in-database filtering
  bulkImportExport             Boolean                      @default(false) // CSV/Excel upload & download
  apiAccess                    Boolean                      @default(false) // External API integration
  prioritySupport              Boolean                      @default(false) // Support priority flag
  customIntegrations           Boolean                      @default(false) // CRM/ERP/BI integrations (Enterprise only)
  dedicatedManager             Boolean                      @default(false) // Assigned account manager (Enterprise only)
  privateModelTuning           Boolean                      @default(false) // Industry-specific AI model tuning (Enterprise only)
  slaUptimeGuarantee           Boolean                      @default(false) // SLA-backed uptime (Enterprise only)
  earlyBetaAccess              Boolean                      @default(false) // Early access to beta features
  quarterlyReview              Boolean                      @default(false) // Quarterly strategy & usage review
  createdAt                    DateTime                     @default(now())
  isActive                     Boolean                      @default(true)
  companySubscription          CompanySubscription[]
  companySubscriptionHistories CompanySubscriptionHistory[]

  @@index([name], name: "idx_subscription_plan_name")
  @@map("subscription_plans")
}

model UsageRecord {
  id             String   @id @default(uuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  timestamp      DateTime? @default(now())// e.g. "OpenAI-GPT-4"
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  toolUsed       String?  @default("") 
  totalTokens    Int      @default(0)
  costUSD        Decimal  @default(0) // Internal cost
  creditsCharged Int      @default(1) // Credits deducted from plan
  metadata       Json? // Optional: store query text, model name, etc.

  @@index([companyId])
  @@map("usage_record")
}

model CompanySubscription {
  id                   String             @id @default(uuid())
  status               SubscriptionStatus // active, cancelled, expired, past_due
  billingCycle         BillingCycle       @default(MONTHLY) // monthly, yearly
  startPeriod          DateTime           @default(now())
  endPeriod            DateTime           @default(now())
  totalCredits         Decimal            @default(0) // Total credits available
  remainingCredits     Decimal            @default(0) // Remaining credits
  isCancelAtPeriodEnd  Boolean            @default(false)
  stripeSubscriptionId String             @unique
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  // Relationships
  companyId            String             @unique
  company              Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscriptionPlanId   String
  subscriptionPlan     SubscriptionPlan   @relation(fields: [subscriptionPlanId], references: [id], onDelete: Cascade)
  purchaseHistory      PurchaseHistory[]

  @@index([companyId])

  @@map("company_subscriptions")
}

model CompanySubscriptionHistory {
  id                   String             @id @default(uuid())
  status               SubscriptionStatus // active, cancelled, expired, past_due
  billingCycle         BillingCycle       @default(MONTHLY) // monthly, yearly
  startPeriod          DateTime           @default(now())
  endPeriod            DateTime           @default(now())
  isCancelAtPeriodEnd  Boolean            @default(false)
  stripeSubscriptionId String             @unique
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  // Relationships
  companyId            String
  company              Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscriptionPlanId   String
  subscriptionPlan     SubscriptionPlan   @relation(fields: [subscriptionPlanId], references: [id], onDelete: Cascade)
  purchaseHistories    PurchaseHistory[]
  @@index([companyId])
  @@map("company_subscription_history")
}

enum PaymentStatus {
  SUCCESS
  FAILED
}

model PurchaseHistory {
  id                    String        @id @default(uuid())
  amount                Decimal       @default(0) // Amount charged
  currency              String        @default("USD") // Currency code
  paymentStatus         PaymentStatus // failed, success
  stripePaymentIntentId String // ID from Stripe for tracking
  paymentDate           DateTime      @default(now())

  subscriptionId String
  subscription   CompanySubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  companySubscriptionHistoryId String
  companySubscriptionHistory   CompanySubscriptionHistory @relation(fields: [companySubscriptionHistoryId], references: [id], onDelete: Cascade)
  @@index([companyId])
  @@index([paymentStatus], name: "idx_purchase_history_payment_status")
  @@map("purchase_history")
}

enum ResourceType {
  API_REQUEST
  CHAT
}

model UsageTracking {
  id           String       @id @default(uuid())
  resourceType ResourceType
  usageCount   Int          @default(1) // Count of API requests or chat messages
  createdAt    DateTime     @default(now())
  companyId    String
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("usage_tracking")
}
